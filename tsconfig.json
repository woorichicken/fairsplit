{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["vite/client", "@cloudflare/workers-types"], "noEmit": true, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src", "worker", "vite.config.ts"]
}
